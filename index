 },
 {
 id:3,
 n:'Iranian Pistachio',
 m:'Salted & Roasted',
 p:1250,
 old:0,
 disc:'',
 img:'https://images.unsplash.com/photo-1587301433005-e95c3f7e2b52?auto=format&fit=crop&w=600&q=80'
 },
 {
 id:4,
 n:'Akhrot Giri',
 m:'Premium Walnut Kernels',
 p:1100,
 old:1200,
 disc:'8% OFF',
 img:'https://images.unsplash.com/photo-1609951651556-5334e57a6d8c?auto=format&fit=crop&w=600&q=80'
 },
 {
 id:5,
 n:'Afghani Anjeer',
 m:'Naturally Sweet Figs',
 p:920,
 old:0,
 disc:'',
 img:'https://images.unsplash.com/photo-1599599810694-b5b37304c041?auto=format&fit=crop&w=600&q=80'
 },
 {
 id:6,
 n:'Premium Raisins',
 m:'Seedless Golden Raisins',
 p:420,
 old:0,
 disc:'',
 img:'https://images.unsplash.com/photo-1596591868231-05e260e3e0dc?auto=format&fit=crop&w=600&q=80'
 }
 ];

 let cart = [];

 function renderProducts(){
 let q = document.getElementById('search').value.toLowerCase();
 let arr = products.filter(x => (x.n + x.m).toLowerCase().includes(q));

 document.getElementById('productGrid').innerHTML = arr.map(x => `
 <article class="card">
 ${x.disc ? `<span class="badge">${x.disc}</span>` : ''}
 <img src="${x.img}" alt="${x.n}">
 <div class="card-body">
 <div class="name">${x.n}</div>
 <div class="small">${x.m} • दर / 500g</div>
 <div class="price">
 ₹${x.p}
 ${x.old ? `<span class="mrp">₹${x.old}</span>` : ''}
 </div>
 <div class="add-row">
 <input id="q${x.id}" class="qty" type="number" value="1" min="1">
 <button class="btn dark" onclick="addCart(${x.id})">Add to Bucket</button>
 </div>
 </div>
 </article>
 `).join('');
 }

 function addCart(id){
 let p = products.find(x => x.id === id);
