 <script>
 const products = [
 {
 id:1,
 n:'Premium Kaju',
 m:'W320 Whole Cashews',
 p:950,
 old:1050,
 disc:'10% OFF',
 img:'https://images.unsplash.com/photo-1606923829579-0cb981a83e2e?auto=format&fit=crop&w=600&q=80'
