<!DOCTYPE html>
<html lang="mr">
<head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <title>Smit Premium Dry Fruits | Aadai, New Panvel</title>
 <style>
 :root{
 --ink:#102b22; --green:#123d2e; --mint:#e9f1e9;
 --gold:#c89b3c; --cream:#fbf8ef; --white:#fff;
 --shadow:0 15px 40px rgba(16,43,34,.12);
 }
 *{box-sizing:border-box}
 body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Arial,sans-serif;background:var(--cream);color:#1f2924}
 button,input,select,textarea{font:inherit}
 button{cursor:pointer;border:0}
.top{background:var(--ink);color:#eee4cb;text-align:center;padding:9px 16px;font-size:13px;font-weight:700}
.nav{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:16px 6%;background:rgba(251,248,239,.96);backdrop-filter:blur(10px);border-bottom:1px solid #e7dfca}
.logo{font-family:Georgia,serif;font-size:23px;font-weight:800;color:var(--green)}
.logo span{color:var(--gold)}
.links{display:flex;gap:20px;color:#315042;font-size:14px}
.nav-actions{display:flex;gap:10px;align-items:center}
.btn{padding:11px 17px;border-radius:9px;font-weight:800;transition:.2s}
.btn:hover{transform:translateY(-2px)}
.primary{background:var(--gold);color:#17251f}
.dark{background:var(--green);color:white}
.outline{background:transparent;color:var(--green);border:1px solid #587467}

.hero{
 min-height:500px;padding:75px 8%;
 background:linear-gradient(90deg,rgba(14,48,36,.98),rgba(14,48,36,.74)),
 url('https://images.unsplash.com/photo-1599599810694-b5b37304c041?auto=format&fit=crop&w=1600&q=80') center/cover;
 display:flex;align-items:center;color:white;
 }
.hero-inner{max-width:690px}
.eyebrow{letter-spacing:2px;text-transform:uppercase;font-weight:800;font-size:12px;color:#edc86d}
.hero h1{font:700 clamp(39px,6vw,70px)/1.05 Georgia,serif;margin:14px 0}
.hero p{font-size:18px;line-height:1.6;color:#e2eee7;max-width:580px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
.chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:25px}
.chip{padding:8px 12px;border:1px solid #8da99d;border-radius:20px;color:#eaf5ee;font-size:13px}

.wrap{max-width:1260px;margin:auto;padding:65px 5%}
.section-title{display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:24px}
.section-title h2{font:700 34px Georgia,serif;color:var(--green);margin:0}
.section-title p{margin:6px 0 0;color:#627168}
.search{width:min(440px,100%);padding:13px 15px;border-radius:9px;border:1px solid #d3d8cc;background:white;outline:none}

.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:19px}
.card{position:relative;border-radius:14px;background:white;box-shadow:var(--shadow);overflow:hidden}
.card img{width:100%;height:170px;object-fit:cover}
.card-body{padding:15px}
.badge{position:absolute;top:12px;left:12px;background:#b34833;color:white;border-radius:6px;padding:6px 8px;font-size:12px;font-weight:800}
.name{font-weight:850;color:var(--ink);font-size:17px}
.small{font-size:13px;color:#647268;margin-top:5px}
.price{display:flex;gap:8px;align-items:center;margin:12px 0;font-weight:850;color:var(--green)}
.mrp{text-decoration:line-through;color:#888;font-weight:500;font-size:13px}
.add-row{display:flex;gap:7px}
.qty{width:65px;border:1px solid #d7dfd7;border-radius:7px;text-align:center}
.add-row.btn{flex:1;padding:10px}

.perks{background:var(--mint);padding:28px 5%;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;text-align:center}
.perk strong{color:var(--green);display:block}
.perk span{font-size:13px;color:#5e7064}

.how{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}
.step{padding:22px;border:1px solid #dedccd;border-radius:12px;background:#fff}
.num{color:var(--gold);font-size:26px;font-family:Georgia,serif;font-weight:bold}
.step h3{margin:5px 0;color:var(--green);font-size:17px}
.step p{margin:0;color:#67746b;font-size:14px;line-height:1.45}

.footer{background:var(--ink);color:#dce9df;padding:45px 7%;display:grid;grid-template-columns:2fr 1fr 1fr;gap:26px}
.footer h3{color:#edc86d;margin-top:0}
.footer p{line-height:1.6;color:#b7c8bd}

.fab{position:fixed;right:22px;bottom:22px;z-index:30;background:var(--green);color:#fff;width:60px;height:60px;border-radius:50%;box-shadow:0 10px 25px #183e2b99;font-size:25px}
.bucket{position:fixed;right:22px;bottom:94px;z-index:30;background:var(--gold);color:#173024;padding:12px 15px;border-radius:24px;font-weight:900;box-shadow:var(--shadow)}

.modal{position:fixed;inset:0;background:#091810a8;z-index:50;display:none;align-items:center;justify-content:center;padding:17px}
.modal.show{display:flex}
.panel{width:min(650px,100%);max-height:92vh;overflow:auto;background:#fbfaf5;border-radius:15px;padding:24px;box-shadow:0 20px 70px #0008}
.panel h2{color:var(--green);font-family:Georgia,serif;margin-top:0}
.close{float:right;font-size:23px;background:none;color:#234}
.field{width:100%;padding:12px;margin:7px 0 13px;border:1px solid #d1d8cf;border-radius:7px}
.login-note{font-size:12px;color:#607066;background:#edf4ed;padding:10px;border-radius:6px}
.admin-tabs{display:flex;gap:7px;flex-wrap:wrap;border-bottom:1px solid #d8ded6;padding-bottom:12px;margin-bottom:15px}
.tab{padding:8px 10px;background:#eaf1eb;color:#18412f;border-radius:6px;font-size:13px;font-weight:700}
.tab.active{background:var(--green);color:white}
.admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.box{border:1px solid #d9e0d7;border-radius:8px;padding:14px;background:#fff}
.box h3{margin:0 0 8px;color:#19412f;font-size:16px}
.status{color:#087947;font-weight:bold;font-size:13px}

.chat{position:fixed;right:20px;bottom:95px;z-index:35;width:330px;background:white;border-radius:14px;box-shadow:0 15px 45px #123b2d55;display:none;overflow:hidden}
.chat.show{display:block}
.chat-head{background:var(--green);color:#fff;padding:15px;font-weight:800}
.chat-body{height:240px;overflow:auto;padding:13px;background:#fcfdfb}
.msg{font-size:13px;line-height:1.35;margin:8px 0;padding:10px;border-radius:9px;background:#edf4ed}
.msg.user{background:#f9e7b7;margin-left:30px}
.chat-input{display:flex;padding:10px;gap:8px;border-top:1px solid #dde5dc}
.chat-input input{min-width:0;flex:1;border:1px solid #ccd8cb;border-radius:7px;padding:9px}
.checkout-line{padding:10px 0;border-bottom:1px dashed #ced7ce}
.total{font-size:20px;font-weight:900;color:var(--green);margin:16px 0}
.hidden{display:none}

 @media(max-width:720px){
.links{display:none}
.nav{padding:14px 4%}
.hero{padding:60px 7%}
.perks,.how{grid-template-columns:repeat(2,1fr)}
.footer{grid-template-columns:1fr}
.admin-grid{grid-template-columns:1fr}
.nav-actions.outline{display:none}
 }
 @media(max-width:430px){
.perks,.how{grid-template-columns:1fr}
.hero h1{font-size:39px}
.bucket{right:12px}
.chat{right:10px;width:calc(100% - 20px)}
 }
 </style>
</head>

